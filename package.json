{
  "name": "ringforge",
  "version": "0.5.1",
  "description": "RingForge plugin for OpenClaw — connect any AI agent to a RingForge fleet",
  "main": "index.js",
  "openclaw": {
    "extensions": [
      "./index.js"
    ]
  },
  "scripts": {
    "build": "npx esbuild index.src.ts --bundle --platform=node --target=node18 --format=cjs --outfile=index.js --external:ws"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "keywords": [
    "openclaw",
    "ringforge",
    "agent-mesh",
    "multi-agent",
    "websocket"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eshe-huli/ringforge-openclaw"
  },
  "devDependencies": {
    "esbuild": "^0.27.3"
  }
}
